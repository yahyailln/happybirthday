      <input type="password" id="passInput" placeholder="أدخل الكود">
      <button onclick="checkCode()">فتح</button>
      <p id="errorMsg" style="color: #ff4d4d; margin-top: 10px; display: none;">الكود خاطئ!</p>
    </div>

    <div class="secret-content" id="secretContent">
      <h2>🎉 ألبوم الذكريات 🎉</h2>
      
      <div class="gallery">
        <img src="photo1.jpg" alt="Memory 1">
